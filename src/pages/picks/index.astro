---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { all, listed } from '../../lib/site';
import { PICKS } from '../../content.config';

const products = (await listed('products')).sort((a, b) => +b.data.updatedAt - +a.data.updatedAt);
const brands = new Map((await all('brands')).map((b) => [b.id, b.data.name]));
const sections = (Object.keys(PICKS) as (keyof typeof PICKS)[])
  .map((k) => ({ key: k, label: PICKS[k], items: products.filter((p) => p.data.picks.includes(k)) }));
---
<Base title="AI產品嚴選" description="月奈創角的嚴選清單：最新嚴選、本月嚴選、編輯嚴選、黑科技、冷門好物、值得關注。每一項都有適合誰、不適合誰與缺點。"
  crumbs={[{ name: 'AI產品嚴選', path: '/picks/' }]}>
  <div class="shell">
    <header class="page-hd">
      <p class="kicker">AI產品嚴選</p>
      <h1>我們替你找到真正值得關注的產品</h1>
      <p class="lead">每一項嚴選都寫明「不適合誰」與缺點。沒有缺點的推薦是廣告，不是選品。</p>
    </header>
    <nav class="chips" aria-label="嚴選分區">
      {sections.map((s) => <a href={`#${s.key}`}>{s.label}<span class="count">{s.items.length}</span></a>)}
    </nav>
    {sections.map((s) => (
      <section class="block" id={s.key}>
        <h2>{s.label}</h2>
        {s.items.length
          ? <div class="grid cards">{s.items.map((p) => <ProductCard product={p} brand={brands.get(p.data.brand.id)} />)}</div>
          : <p class="muted">這一區目前沒有產品。</p>}
      </section>
    ))}
  </div>
</Base>
