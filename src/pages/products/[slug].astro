---
import { getEntry, getEntries, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Sources from '../../components/Sources.astro';
import ProductCard from '../../components/ProductCard.astro';
import Share from '../../components/Share.astro';
import { showcase, COUPON } from '../../lib/showcase';
import { outbound } from '../../lib/affiliate';
import { all, listed, path, twd, ymd, isDraft, MEDIA_LABEL } from '../../lib/site';
import { PICKS, CON_KINDS, STAGES, LOG_KINDS } from '../../content.config';

export async function getStaticPaths() {
  return (await all('products')).map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}
const { product } = Astro.props as { product: CollectionEntry<'products'> };
const d = product.data;
const { Content } = await render(product);
const brand = await getEntry(d.brand);
const category = await getEntry(d.category);
const needs = await getEntries(d.needs);
const competitors = await getEntries(d.competitors);
const comparisons = (await listed('comparisons')).filter((c) => c.data.products.some((p) => p.id === product.id));
const draft = isDraft(product);
const testing = d.stage === 'testing';
// 實驗筆記：新的在上面。有開始日就標「第 N 天」（開始那天是第 1 天），開始前的功課不標。
const start = d.experiment?.startedAt;
const dayOf = (dt: Date) => (start && +dt >= +start ? Math.floor((+dt - +start) / 86400000) + 1 : null);
const log = [...d.log].sort((a, b) => +b.date - +a.date);

const site = Astro.site!.toString().replace(/\/$/, '');
const url = `${site}${path.product(product.id)}`;
const list = (items: string[]) => ({
  '@type': 'ItemList',
  itemListElement: items.map((name, i) => ({ '@type': 'ListItem', position: i + 1, name })),
});
// Product + 編輯評論（pros/cons 走 positiveNotes / negativeNotes，Google 的編輯評論支援這組欄位）。
// 只放頁面上看得到的欄位；沒有的就不輸出，不補預設值。
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${url}#product`,
    name: d.name,
    url,
    description: d.verdict,
    brand: { '@type': 'Brand', name: brand.data.name },
    category: category.data.name,
    ...(d.image ? { image: new URL(d.image, `${site}/`).toString() } : {}),
    ...(d.price ? {
      offers: {
        '@type': 'Offer',
        price: d.price.amount,
        priceCurrency: d.price.currency,
        url: d.buy[0]?.url ?? d.price.source,
      },
    } : {}),
    // 實驗中還沒有結論，不輸出評論
    ...(testing ? {} : {
      review: {
        '@type': 'Review',
        author: { '@type': 'Organization', name: '月奈創角', url: `${site}/` },
        datePublished: ymd(d.publishedAt),
        reviewBody: d.verdict,
        positiveNotes: list(d.pros),
        negativeNotes: list(d.cons.map((c) => c.text)),
      },
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url,
    name: d.name,
    inLanguage: 'zh-Hant-TW',
    datePublished: ymd(d.publishedAt),
    dateModified: ymd(d.updatedAt),
    about: { '@id': `${url}#product` },
    ...(d.sources.length ? {
      citation: d.sources.map((s) => ({
        '@type': 'CreativeWork',
        name: s.title,
        url: s.url,
        ...(s.publisher ? { publisher: { '@type': 'Organization', name: s.publisher } } : {}),
      })),
    } : {}),
  },
  ...d.media.filter((m) => m.uploadDate && m.thumbnail).map((m) => ({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: m.title,
    contentUrl: m.url,
    uploadDate: ymd(m.uploadDate!),
    thumbnailUrl: m.thumbnail,
    description: `${d.name}：${m.title}`,
  })),
];
if (d.faq.length) jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const { pickIf } = await showcase();
const hero = d.image ?? '/images/korena/mood-gold.jpg';
const gallery = d.gallery.length ? [hero, ...d.gallery].slice(0, 3) : [];
const hasCompare = pickIf.some((p) => p.entry.id === product.id);
const buy = d.buy[0];
const go = buy ? outbound(buy.url, brand) : null;
// 折扣碼只掛在同一檔活動的產品上（以購買連結網址判斷，不另設欄位）
const coupon = buy?.url.includes('1010autumn') ? COUPON : null;

---
<Base
  title={d.name}
  description={d.verdict}
  draft={draft}
  image={hero}
  crumbs={[
    { name: category.data.group, path: '/categories/' },
    { name: category.data.name, path: path.category(category.id) },
    { name: d.name, path: path.product(product.id) },
  ]}
  jsonLd={jsonLd}
>
  <div class="a-shell a-prod">
    <div class="a-prod-media">
      <figure class="a-polaroid">
        <span class="a-tape"></span>
        <img src={hero} alt={d.name} width="600" height="750" />
        <figcaption>{brand.data.name} ✦ {testing ? '實驗中' : '月奈嚴選'}</figcaption>
      </figure>
      {gallery.length > 0 && <div class="a-thumbs">{gallery.map((g) => <img src={g} alt="" loading="lazy" width="96" height="96" />)}</div>}
    </div>

    <div>
      <p>
        {testing && <><span class="a-chip a-chip-lab">{STAGES.testing}{start ? `・${ymd(start)} 開始` : ''}</span> </>}
        <a class="a-chip" href={path.brand(brand.id)}>{brand.data.name}</a>
        {d.picks.map((k) => <> <a class="a-chip a-chip-mint" href={`/picks/#${k}`}>{PICKS[k]}</a></>)}
      </p>
      <h1>{d.name}</h1>
      <div class={testing ? 'a-say a-say-lab' : 'a-say'}><p>{d.verdict}</p></div>

      {d.price && <p class="a-bigprice">{twd(d.price.amount)}<small><a href={d.price.source} rel="nofollow noopener" target="_blank">{ymd(d.price.asOf)} 官網價</a></small></p>}
      {coupon && (
        <div class="a-ticket">
          <div>
            <strong>{coupon.note}・結帳輸入折扣碼再折 {twd(coupon.off)}</strong>
            <code>{coupon.code}</code>
          </div>
          <button type="button" data-copy={coupon.code} data-copy-label="複製折扣碼">複製折扣碼</button>
        </div>
      )}
      <div class="a-cta-row">
        {buy && go && <a class="a-btn a-btn-main" href={go.href} target="_blank" rel={go.rel} data-out={product.id} data-brand={brand.id} data-place="hero">{buy.label} ↗</a>}
        {testing && <a class="a-btn a-btn-ghost" href="#lab">看實驗筆記</a>}
        {hasCompare && <a class="a-btn a-btn-ghost" href="#compare">跟其他組比比看</a>}
      </div>
      <div style="margin-top:1.5rem"><Share url={`${site}${path.product(product.id)}`} text={`月奈推薦：${d.name}——${d.verdict}`} /></div>
    </div>
  </div>

  <section class="a-sec a-band" id="why">
    <div class="a-shell a-prod" style="padding:0">
      <div>
        <h2>{testing ? '為什麼想研究它' : '為什麼月奈選它'}</h2>
        <p>{d.whySelected}</p>
        {d.experiment && <>
          <h3>這次想驗證</h3>
          <p class="a-question">{d.experiment.question}</p>
        </>}
      </div>
      <div>
        <h2>{testing ? '成分與配方' : '盒子裡有什麼'}</h2>
        <ul class="a-list">{d.highlights.map((h) => <li>{h}</li>)}</ul>
      </div>
    </div>
  </section>

  {d.experiment && (
    <section class="a-sec" id="lab">
      <div class="a-shell">
        <header class="a-sec-hd"><h2>實驗筆記</h2><p>按日期記，新的在上面{testing && '・用完才下結論'}</p></header>
        <div class="a-lab">
          <div class="a-watch">
            <h3>要觀察的事</h3>
            <ol>{d.experiment.watch.map((w) => <li>{w}</li>)}</ol>
          </div>
          <ol class="a-log">
            {log.map((e) => (
              <li class={`a-log-${e.kind}`}>
                <p class="a-log-meta"><time datetime={ymd(e.date)}>{ymd(e.date)}</time> <span class="a-chip">{dayOf(e.date) ? `第 ${dayOf(e.date)} 天` : LOG_KINDS[e.kind]}</span></p>
                <h3>{e.title}</h3>
                <p>{e.note}</p>
                {e.refs.length > 0 && <p class="a-log-refs">資料：{e.refs.map((r, i) => <>{i > 0 && '・'}<a href={r.url} target="_blank" rel="nofollow noopener">{r.title}</a></>)}</p>}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )}

  {(d.fitFor.length > 0 || d.notFitFor.length > 0 || d.cons.length > 0) && (
  <section class="a-sec" id="fit">
    <div class="a-shell a-fit">
      {d.fitFor.length > 0 && <div>
        <h3>{testing ? '官網說適合…' : '適合你，如果你是…'}</h3>
        <ul>{d.fitFor.map((x) => <li>{x}</li>)}</ul>
      </div>}
      <div>
        <h3>{testing ? '開始前就知道的限制' : '先想一下，如果你是…'}</h3>
        <ul>
          {d.notFitFor.map((x) => <li>{x}</li>)}
          {d.cons.map((c) => <li>{c.kind && <><span class="a-chip">{CON_KINDS[c.kind]}</span> </>}{c.text}</li>)}
        </ul>
      </div>
    </div>
  </section>
  )}

  {hasCompare && (
    <section class="a-sec a-band a-band-butter" id="compare">
      <div class="a-shell">
        <header class="a-sec-hd"><h2>三組怎麼選？</h2>{comparisons[0] && <p><a href={path.comparison(comparisons[0].id)}>看完整比較表 →</a></p>}</header>
        <div class="a-who">
          {pickIf.map((p) => (
            <a href={path.product(p.entry.id)} aria-current={p.entry.id === product.id ? 'page' : undefined}>
              <span class="q">「{p.if}」</span>
              <span class="ans">→ {p.entry.data.name}{p.entry.data.price && `・${twd(p.entry.data.price.amount)}`}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="a-shell">
    <section class="block prose" id="notes">
      <Content />
    </section>

    {d.specs.length > 0 && (
      <section class="block" id="specs">
        <h2>{testing ? '規格與成分' : '規格與效期'}</h2>
        <div class="table-wrap">
          <table class="data">
            <tbody>{d.specs.map((s) => <tr><th scope="row">{s.label}</th><td>{s.value}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="muted small">取自品牌官網規格說明。</p>
      </section>
    )}

    {d.media.length > 0 && (
      <section class="block" id="media">
        <h2>影音</h2>
        <ul class="media-list">
          {d.media.map((m) => <li><span class="tag">{MEDIA_LABEL[m.platform]}</span> <a href={m.url} target="_blank" rel="noopener">{m.title}</a></li>)}
        </ul>
      </section>
    )}

    <Faq items={d.faq} title="大家都在問" />

    {competitors.length > 0 && (
      <section class="block">
        <h2>你可能也喜歡</h2>
        <div class="grid cards">{competitors.map((p) => <ProductCard product={p} />)}</div>
      </section>
    )}

    {needs.length > 0 && (
      <section class="block">
        <h2>相關需求</h2>
        <ul class="chips">{needs.map((n) => <li><a href={path.need(n.id)}>{n.data.name}</a></li>)}</ul>
      </section>
    )}

    <Sources items={d.sources} />

    <section class="block" id="changelog">
      <h2>更新紀錄</h2>
      <ul class="changelog">
        {[...d.changelog].sort((a, b) => +b.date - +a.date).map((c) => (
          <li><time datetime={ymd(c.date)}>{ymd(c.date)}</time>　{c.note}</li>
        ))}
      </ul>
      <p class="muted small">首次發布 {ymd(d.publishedAt)}・最後更新 {ymd(d.updatedAt)}</p>
    </section>
  </div>

  {d.price && buy && (
    <div class="a-sticky">
      <div class="a-shell">
        <span><b>{twd(d.price.amount)}</b>{coupon && <>　折扣碼 <code>{coupon.code}</code> 再折 {twd(coupon.off)}</>}</span>
        <a class="a-btn a-btn-main" href={go!.href} target="_blank" rel={go!.rel} data-out={product.id} data-brand={brand.id} data-place="sticky">去官網 ↗</a>
      </div>
    </div>
  )}
  <script>
    // 點購買按鈕送 GA 事件 buy_click（產品、品牌、位置、是否聯盟連結）。選品 SOP 用它判斷哪些產品真的有人想買。
    // 開發建置沒有載入 GA，gtag 不存在時什麼都不做。
    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-out]')) {
      a.addEventListener('click', () => {
        const g = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
        g?.('event', 'buy_click', {
          product_id: a.dataset.out, brand_id: a.dataset.brand, placement: a.dataset.place,
          affiliate: a.rel.includes('sponsored') ? 'yes' : 'no',
          transport_type: 'beacon',
        });
      });
    }
  </script>
</Base>
