---
import Base from '../../layouts/Base.astro';
import { listed, path, ymd } from '../../lib/site';
const guides = (await listed('guides')).sort((a, b) => +b.data.updatedAt - +a.data.updatedAt);
const kinds = ['選品指南', '購買指南', '使用者痛點', '產品趨勢', '產業觀察'] as const;
---
<Base title="深度選品" description="選品指南、購買指南、使用者痛點、產品趨勢與產業觀察。" crumbs={[{ name: '深度選品', path: '/guides/' }]}>
  <div class="shell">
    <header class="page-hd"><p class="kicker">深度選品</p><h1>把選擇的方法講清楚</h1></header>
    {kinds.map((k) => {
      const items = guides.filter((g) => g.data.kind === k);
      return items.length > 0 && (
        <section class="block">
          <h2>{k}</h2>
          <ul class="guide-list">{items.map((g) => (
            <li><a href={path.guide(g.id)}><strong>{g.data.title}</strong></a>
              <p>{g.data.answer}</p><p class="muted small">更新 {ymd(g.data.updatedAt)}</p></li>))}</ul>
        </section>
      );
    })}
  </div>
</Base>
