---
import Base from '../../layouts/Base.astro';
import { listed, path, ymd, TOPICS } from '../../lib/site';
const guides = new Map((await listed('guides')).map((g) => [g.id, g]));
const cmps = new Map((await listed('comparisons')).map((c) => [c.id, c]));
// 依主題分組；只列 published 的（listed），主題裡一篇都沒有就不顯示
const topics = TOPICS.map((t) => ({
  ...t,
  items: t.guides.map((id) => guides.get(id)).filter((g) => !!g),
  cmpItems: t.comparisons.map((id) => cmps.get(id)).filter((c) => !!c),
})).filter((t) => t.items.length + t.cmpItems.length > 0);
---
<Base title="指南" description={`從問題找答案：${topics.map((t) => t.name).join('、')}。每篇都標出資料來源。`} crumbs={[{ name: '指南', path: '/guides/' }]}>
  <div class="shell">
    <header class="page-hd"><p class="kicker">指南</p><h1>從問題找答案</h1></header>
    <ul class="chips">{topics.map((t) => <li><a href={`#${t.id}`}>{t.name}<span class="count">{t.items.length + t.cmpItems.length}</span></a></li>)}</ul>
    {topics.map((t) => (
      <section class="block" id={t.id}>
        <h2>{t.name}</h2>
        <p class="muted">{t.intro}</p>
        <ul class="guide-list">
          {t.items.map((g) => (
            <li><a href={path.guide(g!.id)}><strong>{g!.data.title}</strong></a>
              <p>{g!.data.answer}</p><p class="muted small">更新 {ymd(g!.data.updatedAt)}</p></li>))}
          {t.cmpItems.map((c) => (
            <li><span class="a-chip">比較</span> <a href={path.comparison(c!.id)}><strong>{c!.data.title}</strong></a>
              <p>{c!.data.answer}</p><p class="muted small">更新 {ymd(c!.data.updatedAt)}</p></li>))}
        </ul>
      </section>
    ))}
  </div>
</Base>
