---
import Base from '../../layouts/Base.astro';
import { all, path } from '../../lib/site';
const needs = await all('needs');
const groups = (['情境', '族群', '送禮'] as const).map((g) => ({ name: g, items: needs.filter((n) => n.data.group === g) }));
// 還沒有頁面的需求只列名稱，讓人知道網站會涵蓋什麼，但不產生空頁
const planned: Record<string, string[]> = {
  情境: ['想提高工作效率', '想改善生活', '在家工作', '旅行'],
  族群: ['小家庭', '上班族', '親子'],
  送禮: ['想送禮'],
};
---
<Base title="找需求" description="從你的需求出發找產品：先說問題，再給解法與嚴選產品。" crumbs={[{ name: '找需求', path: '/needs/' }]}>
  <div class="shell">
    <header class="page-hd"><p class="kicker">找需求</p><h1>先說你的問題，再找產品</h1>
      <p class="lead">不是「分類 → 商品」，而是「需求 → 問題 → 解法 → 產品」。</p></header>
    <div class="groups">
      {groups.map((g) => (
        <section class="group">
          <h2>{g.name}</h2>
          <ul class="links">
            {g.items.map((n) => <li><a href={path.need(n.id)}>{n.data.name}</a></li>)}
            {planned[g.name].filter((p) => !g.items.some((n) => n.data.name === p)).map((p) => <li class="muted">{p}（整理中）</li>)}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
