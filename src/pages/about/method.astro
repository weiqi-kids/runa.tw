---
import Base from '../../layouts/Base.astro';
const steps = [
  ['讀原文', '先讀品牌官網的商品頁原文，包括介紹、組合內容、規格說明，並記下查閱日期。'],
  ['列清單', '把「實際會拿到什麼」逐項列出來。介紹文字與組合清單不一致時，以清單為準，並把不一致寫在頁面上。'],
  ['自己算', '不採用品牌標示的原價與「現省」金額；用實際售價重新計算，算式寫在頁面上。'],
  ['分開宣稱與事實', '品牌對功效的描述放在「品牌宣稱（本站未驗證）」區塊，不混進我們的結論。'],
  ['實際使用', '能實測的產品實際使用後才發布；尚未實測的頁面標示「草稿・未實測」，不收錄於搜尋引擎。'],
  ['寫缺點', '每個產品至少一項缺點、至少一種「不適合的人」。寫不出來，代表還沒研究夠。'],
  ['持續更新', '價格、活動、新版本出現時更新同一頁，並寫進更新紀錄，網址永遠不變。'],
];
---
<Base title="選品方法" description="月奈創角怎麼研究一個產品：讀原文、列清單、自己算、分開宣稱與事實、實際使用、寫缺點、持續更新。"
  crumbs={[{ name: '關於', path: '/about/' }, { name: '選品方法', path: '/about/method/' }]}>
  <article class="shell">
    <header class="page-hd"><p class="kicker">關於</p><h1>選品方法</h1></header>
    <ol class="steps block">{steps.map(([t, d]) => <li><strong>{t}</strong><p>{d}</p></li>)}</ol>
    <section class="block prose">
      <h2>AI 在這裡做什麼</h2>
      <p>AI 協助我們蒐集與比對來源：抓取官網頁面、逐項比對組合內容、檢查數字算不算得起來。結論、缺點與「適合誰」由編輯判斷並署名負責。</p>
    </section>
  </article>
</Base>
