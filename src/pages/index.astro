---
import { getEntries } from 'astro:content';
import Base from '../layouts/Base.astro';
import Share from '../components/Share.astro';
import { listed, path, twd, ymd, isTesting, latestLog, SITE_NAME, TAGLINE } from '../lib/site';
import { showcase, SOCIAL, COUPON } from '../lib/showcase';
import { PICKS, LOG_KINDS } from '../content.config';

const { brands, products: all, pickIf } = await showcase();
// 實驗中的放「最近在研究」，有結論的才進 TOP 與推薦理由
const testing = all.filter(isTesting).sort((a, b) => +(latestLog(b.data.log)?.date ?? 0) - +(latestLog(a.data.log)?.date ?? 0));
const products = all.filter((p) => !isTesting(p));
const labCover = testing[0]?.data.image;
// 還沒開的社群帳號不顯示
const social = SOCIAL.filter((s) => s.url);
const needs = await listed('needs');
const categories = await listed('categories');
const cmps = await Promise.all((await listed('comparisons')).slice(0, 4).map(async (c) => ({ c, ps: await getEntries(c.data.products) })));
const guides = (await listed('guides')).sort((a, b) => +b.data.updatedAt - +a.data.updatedAt).slice(0, 3);
const suggestions = [...needs.map((n) => n.data.name), ...categories.map((c) => c.data.name)].slice(0, 4);
const site = Astro.site!.toString().replace(/\/$/, '');
const firstPick = (p: (typeof products)[number]) => p.data.picks[0];
---
<Base title={SITE_NAME} description={`${TAGLINE}正在研究的產品、已有結論的嚴選、我適合哪一組，每個產品都有實驗筆記、價格出處與更新紀錄。`}>
  <section class="a-hero">
    <div class="a-shell a-hero-grid">
      <div>
        <span class="a-issue">月奈的研究筆記 ・ 2026 秋</span>
        <h1>月奈最近<br />在研究<em>這些</em></h1>
        <p class="a-hero-lead">AI 幫忙把商品找出來，月奈自己試、自己記：開始前的功課、使用中的觀察、用完的結論，都按日期寫在每一頁。</p>
        <form class="search" role="search" onsubmit="return false">
          <label for="q" class="sr-only">搜尋產品、品牌、需求</label>
          <input id="q" type="search" autocomplete="off" placeholder="你正在找什麼？產品、品牌、需求……" />
          <ul id="q-results" class="search-results" hidden></ul>
        </form>
        <p class="suggest">
          <span class="muted">大家在找：</span>
          {suggestions.map((s) => <button type="button" class="chip-btn" data-q={s}>{s}</button>)}
        </p>
      </div>
      <div class="a-collage" aria-hidden="true">
        <figure class="a-polaroid a-p1">
          <span class="a-tape"></span>
          <img src="/images/korena/promo.jpg" alt="" width="679" height="1200" />
          <figcaption>有結論了 ✦ KORENA</figcaption>
        </figure>
        <figure class="a-polaroid a-p2">
          <span class="a-tape"></span>
          <img src={labCover ?? '/images/korena/set-5.png'} alt="" width="480" height="480" />
          <figcaption>{labCover ? `實驗中 ✦ ${brands.get(testing[0].data.brand.id)?.split(' ')[0]}` : '入門首選 5 入組'}</figcaption>
        </figure>
        <div class="a-sticker a-sticker-hero"><span>折扣碼再折<b>{twd(COUPON.off).replace('NT', '')}</b></span></div>
      </div>
    </div>
  </section>

  {testing.length > 0 && (
    <section class="a-sec" id="lab">
      <div class="a-shell">
        <header class="a-sec-hd">
          <h2>最近在研究 ✎</h2>
          <p>還沒有結論，先看筆記　<a href="/lab/">看全部研究筆記 →</a></p>
        </header>
        <div class="a-lab-list">
          {testing.slice(0, 3).map((p) => {
            const last = latestLog(p.data.log);
            return (
              <article class="a-lab-item">
                <a href={path.product(p.id)}><img src={p.data.image ?? '/images/korena/mood-gold.jpg'} alt={p.data.name} width="240" height="240" loading="lazy" /></a>
                <div>
                  <p><span class="a-chip a-chip-lab">實驗中</span> <span class="muted">{brands.get(p.data.brand.id)}</span></p>
                  <h3><a href={path.product(p.id)}>{p.data.name}</a></h3>
                  {p.data.experiment && <p class="a-question">{p.data.experiment.question}</p>}
                  {last && <p class="a-log-latest">{ymd(last.date)}・{LOG_KINDS[last.kind]}：<b>{last.title}</b></p>}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="a-sec a-band" id="top">
    <div class="a-shell">
      <header class="a-sec-hd">
        <h2>有結論的 TOP 3 ✦</h2>
        <p>點愛心收藏，下次回來直接看　<a href="/picks/">看全部嚴選 →</a></p>
      </header>
      <div class="a-top">
        {products.slice(0, 3).map((p, i) => (
          <article class="a-card">
            <span class="a-rank">{String(i + 1).padStart(2, '0')}</span>
            <button type="button" class="a-heart" aria-pressed="false" data-save={p.id} aria-label={`收藏 ${p.data.name}`}>♡</button>
            <a href={path.product(p.id)}><img class="a-card-img" src={p.data.image ?? '/images/korena/mood-gold.jpg'} alt={p.data.name} width="480" height="480" loading="lazy" /></a>
            {p.data.picks.includes('monthly') && <span class="a-sticker a-card-sticker"><span>本月<b>必看</b></span></span>}
            <div class="a-card-body">
              <p>{firstPick(p) && <span class="a-chip">{PICKS[firstPick(p)]}</span>} {brands.get(p.data.brand.id)}</p>
              <h3><a href={path.product(p.id)}>{p.data.name}</a></h3>
              <p>{p.data.verdict}</p>
              {p.data.price && <div class="a-price"><b>{twd(p.data.price.amount)}</b><span>官網價・{ymd(p.data.price.asOf)}</span></div>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {pickIf.length > 0 && (
    <section class="a-sec" id="who">
      <div class="a-shell">
        <header class="a-sec-hd">
          <h2>我適合哪一組？</h2>
          <p>三秒鐘找到你的那一組</p>
        </header>
        <div class="a-who">
          {pickIf.map((p) => (
            <a href={path.product(p.entry.id)}>
              <span class="q">「{p.if}」</span>
              <span class="ans">→ {p.entry.data.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="a-sec a-band a-band-butter" id="reasons">
    <div class="a-shell">
      <header class="a-sec-hd"><h2>月奈的結論</h2><p>用完之後，一句話說清楚</p></header>
      <div class="a-reasons">
        {products.flatMap((p) => [p.data.verdict, p.data.whySelected].map((t) => (
          <blockquote class="a-bubble">
            <p>{t}</p>
            <a href={path.product(p.id)}>{p.data.name} →</a>
          </blockquote>
        )))}
      </div>
    </div>
  </section>

  <section class="a-sec">
    <div class="a-shell">
      <header class="a-sec-hd"><h2>熱門比較</h2><a class="more" href="/comparisons/">看全部 →</a></header>
      <ul class="cmp-list">
        {cmps.map(({ c, ps }) => (
          <li><a href={path.comparison(c.id)}><strong>{c.data.title}</strong><span class="muted">{[...ps.map((p) => p.data.name), ...c.data.externals.map((e) => e.name)].join(' ／ ')}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="a-sec a-band">
    <div class="a-shell">
      <header class="a-sec-hd"><h2>深度選品</h2><a class="more" href="/guides/">看全部 →</a></header>
      <ul class="guide-list">
        {guides.map((g) => <li><a href={path.guide(g.id)}><strong>{g.data.title}</strong></a><p>{g.data.answer}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="a-sec a-follow" id="follow">
    <div class="a-shell">
      {social.length > 0 ? <>
        <h2>追蹤月奈，新的研究筆記第一個知道</h2>
        <p class="a-hero-lead" style="margin-inline:auto">每一支影片、每一則限動，都連回完整的選品頁。</p>
        <div class="a-social">
          {social.map((s) => <a class="a-btn a-btn-ghost" href={s.url!} target="_blank" rel="noopener">{s.label}</a>)}
        </div>
      </> : <h2>覺得有用？分享給朋友</h2>}
      <div style="display:flex;justify-content:center">
        <Share url={`${site}/`} text="月奈最近在研究的東西，你看看👀" />
      </div>
    </div>
  </section>

  <script>
    // 收藏：只存在這台瀏覽器（localStorage），不上傳。讀寫失敗（無痕模式等）就當作沒收藏。
    const KEY = 'runa.saved';
    const read = (): string[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
    const write = (v: string[]) => { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch {} };
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-save]')) {
      const id = b.dataset.save!;
      const sync = () => { const on = read().includes(id); b.setAttribute('aria-pressed', String(on)); b.textContent = on ? '♥' : '♡'; };
      b.addEventListener('click', () => { const s = read(); write(s.includes(id) ? s.filter((x) => x !== id) : [...s, id]); sync(); });
      sync();
    }

    // 站內搜尋：索引在建置時產生（/search-index.json），第一次聚焦才下載
    type Row = { t: string; n: string; u: string; k: string };
    const input = document.querySelector<HTMLInputElement>('#q')!;
    const out = document.querySelector<HTMLUListElement>('#q-results')!;
    let rows: Row[] | null = null;
    const load = async () => (rows ??= await (await fetch('/search-index.json')).json());
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    async function run() {
      const q = input.value.trim().toLowerCase();
      if (!q) { out.hidden = true; return; }
      const terms = q.split(/\s+/);
      const hits = (await load()).filter((r) => terms.every((t) => `${r.n} ${r.k}`.toLowerCase().includes(t))).slice(0, 8);
      out.innerHTML = hits.length
        ? hits.map((r) => `<li><a href="${r.u}"><span class="tag">${esc(r.t)}</span>${esc(r.n)}</a></li>`).join('')
        : '<li class="muted">找不到符合的結果，試試品牌名或需求，例如「保養」。</li>';
      out.hidden = false;
    }
    input.addEventListener('input', run);
    input.addEventListener('focus', load, { once: true });
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-q]')) {
      b.addEventListener('click', () => { input.value = b.dataset.q!; run(); input.focus(); });
    }
  </script>
</Base>
