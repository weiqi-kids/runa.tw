---
import Base from '../../layouts/Base.astro';
import { all, listed, path, CATEGORY_GROUPS } from '../../lib/site';
const categories = await listed('categories');
const products = await listed('products');
// 品牌只列有可見產品的品牌
const brands = (await all('brands')).filter((b) => products.some((p) => p.data.brand.id === b.id));
const count = (id: string) => products.filter((p) => p.data.category.id === id).length;
const groups = [...new Set([...CATEGORY_GROUPS, ...categories.map((c) => c.data.group)])]
  .map((g) => ({ name: g, items: categories.filter((c) => c.data.group === g) }))
  .filter((g) => g.items.length > 0);
---
<Base title="找產品" description={`依品類找產品：${groups.map((g) => g.name).join("、")}。`} crumbs={[{ name: '找產品', path: '/categories/' }]}>
  <div class="shell">
    <header class="page-hd"><p class="kicker">找產品</p><h1>依品類找產品</h1>
      <p class="lead">每個品類頁先回答「怎麼選」，再列出嚴選與比較。下面每個品類都附上一句選購重點和適合的人，先對照自己的情況，再點進去看細節。</p></header>
    <div class="groups">
      {groups.map((g) => (
        <section class="group">
          <h2>{g.name}</h2>
          <ul class="links">{g.items.map((c) => (
            <li>
              <a href={path.category(c.id)}>{c.data.name}</a> <span class="muted">{count(c.id)} 項</span>
              <p>{c.data.answer}</p>
              {c.data.whoNeedsIt.length > 0 && <p class="muted">適合：{c.data.whoNeedsIt.join('；')}</p>}
            </li>
          ))}</ul>
        </section>
      ))}
    </div>
    <section class="block">
      <h2>不確定要買哪一類？</h2>
      <p>品類是「已經知道要買什麼」的人的入口。如果你只知道自己遇到什麼狀況，可以反過來找：<a href="/needs/">依情境找</a>會從「第一次試」「要送禮」這類情況出發；<a href="/guides/">指南</a>從斑點、痘疤、術後保養這類問題出發，先把原因和做法講清楚，再談產品；已經有幾個候選、只差臨門一腳的人，直接看<a href="/comparisons/">比較</a>，每一頁都把價格換算成同一個基準。</p>
    </section>
    <section class="block">
      <h2>品牌</h2>
      <p>下面是本站目前有收錄產品的品牌。品牌頁整理它的產品線、官網怎麼自我介紹，以及本站的觀察。</p>
      <ul class="links">{brands.map((b) => <li><a href={path.brand(b.id)}>{b.data.name}</a><p class="muted">{b.data.summary}</p></li>)}</ul>
    </section>
  </div>
</Base>
